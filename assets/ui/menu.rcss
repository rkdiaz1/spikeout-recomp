/* The in-game menu's style. After vf3-recomp's assets/ui/menu.rcss (MIT,
   Copyright (c) 2026 mr-finster), in Spikeout's red and orange.

   Sizes are in dp: the menu sets 1dp = 1/720 of the window's height. One
   column with a fixed space for each part, so nothing overlaps whatever the
   page: top 24 + title 53 + crumb 28 + rows 14 x 32 = 448 + note 8 + 80 (4
   lines) + hint 8 + 22 + version 4 + 18 = 693dp of 720. A page longer than
   14 rows scrolls, keeping the selected row in view; a long value is cut,
   never drawn over its label. */

body {
	width: 100%;
	height: 100%;
	font-family: "Barlow Condensed";
	font-weight: 600;
	font-size: 24dp;
	color: #f1e6e0;
}

div { display: block; }

#shade {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	decorator: horizontal-gradient(#100404f2 #10040450);
}

#panel {
	position: absolute;
	left: 9%;
	top: 24dp;
	width: 520dp;
}

#title {
	font-size: 46dp;
	font-weight: bold;
	font-style: italic;
	color: #ff6a1f;
	height: 48dp;
	line-height: 48dp;
	padding-bottom: 2dp;
	border-bottom: 3dp #ff6a1f;
}

#crumb {
	height: 24dp;
	line-height: 24dp;
	margin-bottom: 4dp;
	font-size: 18dp;
	font-weight: 500;
	color: #c99a8a;
	white-space: nowrap;
	overflow: hidden;
}

#rows {
	max-height: 448dp;
	overflow-y: auto; /* (a page longer than this: a thin bar on the right says there's more, and where; the wheel scrolls) */
}

#rows scrollbarvertical { width: 6dp; margin-left: 6dp; }
#rows scrollbarvertical slidertrack { background-color: #2a1a16; border-radius: 3dp; }
#rows scrollbarvertical sliderbar { background-color: #ff8a2c; border-radius: 3dp; min-height: 24dp; }
#rows scrollbarvertical sliderarrowdec, #rows scrollbarvertical sliderarrowinc { width: 0dp; height: 0dp; }

.row {
	display: flex;
	height: 29dp;
	line-height: 29dp;
	padding: 0 16dp;
	margin-bottom: 3dp;
	font-size: 23dp;
	color: #e6d3cc;
	white-space: nowrap;
	transition: padding-left 0.12s cubic-out;
}

.row .label {
	flex: 1 0 auto;
	margin-right: 18dp;
}

.row .value {
	flex: 0 1 auto;
	overflow: hidden;
	color: #ff9a3c;
	text-align: right;
}

.row.selected {
	decorator: horizontal-gradient(#ff8a2c #e8251f);
	color: #1a0705;
	padding-left: 28dp;
}

.row.selected .value { color: #1a0705; }

/* A listed network game: its host's flag before the name, its estimated speed on the right (bars, "~N ms"). */
/* (the flag and the bars as tall as the text's capitals: 0.7 of its 23dp) */
.row .flag { width: 21dp; height: 16dp; margin: 0 10dp 0 0; border: 1dp #000000; vertical-align: baseline; }
/* (its spectators: an eye and their count after the name, as the seat list's; tinted as the text) */
.row .eye { width: 22dp; height: 22dp; margin: 0 3dp 0 10dp; vertical-align: middle; image-color: #f1e6e0; }
.row.selected .eye { image-color: #1a0705; }
.row .speed { flex: 0 0 auto; display: flex; align-items: center; color: #e6d3cc; }
.row.selected .speed { color: #1a0705; }
.row .bars { display: flex; align-items: flex-end; height: 16dp; margin: 4dp 8dp 0 0; } /* (down onto the text's baseline) */
.row .bar { width: 4dp; margin-left: 2dp; background-color: #4a4a4a; border: 1dp #000000; }
.row .bars.g .on { background-color: #5fd35f; }
.row .bars.y .on { background-color: #ffd34a; }
.row .bars.r .on { background-color: #e05555; }

/* A save (the Saves page): taller, its picture (4:3) before two lines: where in the game, then when and how long played. */
.row.tall { height: 60dp; line-height: 26dp; align-items: center; }
.row .thumb { flex: 0 0 auto; width: 72dp; height: 54dp; margin-right: 14dp; border: 1dp #000000; }
.row .thumb.none { background-color: #1a1c22; }
.row.tall .label { display: block; }
.row .line { display: block; }
.row .detail { display: block; font-size: 17dp; line-height: 22dp; color: #b8a8a2; }
.row.selected .detail { color: #3a1a10; }
.row.dim { color: #7a6e6a; }
.row.dim .value, .row.dim .detail { color: #6a605c; }

/* A bar before the value (the in-game update's download), glossy as the game's other progress bars (the owner's
   choice, 2026-11-17): a sunken track, the fill a light yellow top half and a darker bottom half. Its value in a box of
   a fixed width, right-aligned, so that the bar stays still as the numbers change. */
.row .pbar { display: block; flex: 0 6 auto; width: 240dp; min-width: 60dp; height: 12dp; margin: 9dp 14dp 0 0;
	decorator: vertical-gradient(#08090c #262a33); border: 1dp #000000; border-radius: 6dp; }
.row.selected .pbar { decorator: vertical-gradient(#3a0a05 #6a1a10); }
.row .pfill { display: block; height: 100%; }
.row .pfill .gt { display: block; height: 50%; border-radius: 5dp 5dp 0dp 0dp; decorator: vertical-gradient(#fff6c8 #ffe06a); }
.row .pfill .gb { display: block; height: 50%; border-radius: 0dp 0dp 5dp 5dp; decorator: vertical-gradient(#e8a800 #ffcf3a); }
.row .value.pvalue { flex: 0 0 auto; width: 190dp; }

/* An arcade link room (docs/direct-connect.md): each player's row a bar of the link's time (green, yellow, red: its
   grade; the same glossy bar), the time, and a pill (READY / WAITING); the Ready button a pill in the middle; beside
   the rows, the ring of every link (#qrbox's place). */
.row .pbar.short { width: 110dp; }
.row .value.pvalue.short { width: 70dp; }
.row .pbar.green .gt { decorator: vertical-gradient(#d8ffd8 #8fe88f); }
.row .pbar.green .gb { decorator: vertical-gradient(#3fae3f #6fd46f); }
.row .pbar.red .gt { decorator: vertical-gradient(#ffd8d0 #ff8a7a); }
.row .pbar.red .gb { decorator: vertical-gradient(#c03028 #e85a4a); }
/* (the ring's pings (the owner's choice, 2026-11-18): over each lit link a dot going out to the other seat and back,
   as the room's own pings, in a layer the page doesn't make again (MenuPage::side_fx)) */
#sf { position: absolute; left: 0; top: 0; }
@keyframes ping { 0% { left: 0%; } 50% { left: 100%; } 100% { left: 0%; } }
.rfx { position: absolute; height: 0dp; transform-origin: 0% 50%; }
.rping { position: absolute; top: -5dp; left: 0%; width: 10dp; height: 10dp; margin-left: -5dp; border-radius: 5dp;
	background-color: #ffffff; border: 1dp #000000; animation: 1.6s cubic-in-out infinite ping; }
.rbadge.o { background-color: transparent; color: #ff9a3c; border: 2dp #ff6a1f; }
.row.selected .rbadge.o { color: #1a0705; border-color: #1a0705; }
.rbadge { flex: 0 0 auto; width: 76dp; height: 20dp; line-height: 20dp; margin: 4dp 0 0 10dp; text-align: center; font-size: 15dp;
	border-radius: 10dp; border: 1dp #000000; background-color: #4a4a50; color: #e8e8ec; }
.rbadge.g { background-color: #5fd35f; color: #0d2a0d; }
.rbadge.y { background-color: #ffd34a; color: #2a2000; }
.rbadge.r { background-color: #e05555; color: #ffffff; }
.row.btn { justify-content: center; height: 36dp; line-height: 34dp; margin: 10dp 70dp 6dp 70dp; padding: 0 16dp; font-size: 25dp;
	color: #ff9a3c; border: 2dp #ff6a1f; border-radius: 18dp; }
.row.btn .label { flex: 0 0 auto; margin-right: 0; }
.row.btn.selected { padding-left: 16dp; color: #1a0705; border-color: #ffd0a0; }
.row.btn.on { color: #0d2a0d; border-color: #3fae3f; decorator: vertical-gradient(#8fe88f #3fae3f); }
.row.btn.on.selected { border-color: #ffffff; }
.row.btn.dim { color: #6a605c; border-color: #4a403c; }
.row.btn.dim.selected { color: #2a1a16; }
.row.btn.info { height: 36dp; line-height: 34dp; font-size: 25dp; font-weight: 600; margin: 10dp 70dp 6dp 70dp; color: #8a7a74; }
.ring { position: relative; width: 250dp; height: 250dp; }
.rl { position: absolute; height: 4dp; transform-origin: 0% 50%; border-radius: 2dp; }
.rl.thin { height: 2dp; }
.rl.g { background-color: #5fd35f; } .rl.y { background-color: #ffd34a; } .rl.r { background-color: #e05555; }
.rl.off { background-color: #3a3436; } .rl.faint { opacity: 0.4; }
.rs { position: absolute; width: 44dp; height: 44dp; border-radius: 22dp; border: 2dp #8a8a90; background-color: #22252b;
	text-align: center; line-height: 40dp; font-size: 17dp; color: #ffffff; }
.rs.me { border-color: #ff6a1f; }
.rs.sel { background-color: #3a2a1e; border-color: #ffd0a0; }
.rs.out { border-color: #3a3436; background-color: #1a1b1f; color: #55565c; }
.rn { position: absolute; width: 90dp; text-align: center; font-size: 15dp; color: #e6d3cc; }
.rn.out { color: #55565c; }
.rt { position: absolute; width: 56dp; height: 18dp; line-height: 18dp; text-align: center; font-size: 14dp; color: #ffffff;
	background-color: #16171bdd; border-radius: 4dp; }

.row .arrow { color: #c99a8a; }
.row.selected .arrow { color: #1a0705; }

.row.info {
	height: 26dp;
	line-height: 26dp;
	font-size: 19dp;
	font-weight: 500;
	margin-bottom: 0;
}

.row.info .value { color: #f1e6e0; }

#note {
	margin-top: 8dp;
	height: 80dp;
	line-height: 20dp;
	overflow: hidden;
	font-size: 18dp;
	font-weight: 500;
	color: #c99a8a;
}

#hint {
	margin-top: 8dp;
	height: 22dp;
	line-height: 22dp;
	font-size: 17dp;
	font-weight: 500;
	color: #c99a8a;
	white-space: nowrap;
}

.key { color: #f1e6e0; }

#ver {
	margin-top: 4dp;
	height: 18dp;
	line-height: 18dp;
	font-size: 15dp;
	font-weight: 500;
	color: #8a6a60;
	white-space: nowrap;
}

/* A page's QR code (ui::MenuPage::qr): black squares on white, for a phone's camera; to the right of the panel,
   level with the rows (never under them: a short window would cut it). */
#qrbox { position: absolute; left: 548dp; top: 96dp; }
.qrrow { display: block; height: 6dp; }
.qm, .ql { display: inline-block; width: 6dp; height: 6dp; }
.qm { background-color: #000000; }
.ql { background-color: #ffffff; }

/* A text page (ui::TextInput): the text typed so far, wrapped, a cursor at its end. */
#textbox {
	margin: 6dp 16dp 14dp 16dp;
	padding: 8dp 12dp;
	min-height: 40dp;
	font-size: 26dp;
	color: #ffe0c0;
	background-color: #00000080;
	border-bottom: 3dp #ff6a1f;
	white-space: pre-wrap;
}

#textbox.multi { min-height: 180dp; font-size: 22dp; }

.tcursor { color: #ff9a3c; }

/* A code page (ui::CodeInput): the code's box, then an on-screen keyboard
   of 8 keys a row (8 x 50dp) and a row of Delete and Join. */
#codebox {
	margin: 6dp 0 14dp 16dp;
	height: 58dp;
}

.slot {
	display: inline-block;
	width: 42dp;
	height: 52dp;
	line-height: 52dp;
	margin-right: 8dp;
	text-align: center;
	font-size: 42dp;
	color: #ff9a3c;
	border-bottom: 3dp #8a6a60;
}

.slot.cur { border-bottom: 3dp #ff6a1f; }

.krow {
	display: flex;
	margin-left: 16dp;
	margin-bottom: 4dp;
}

.ckey {
	width: 46dp;
	height: 40dp;
	line-height: 40dp;
	margin-right: 4dp;
	text-align: center;
	font-size: 26dp;
	color: #e6d3cc;
	background-color: #3a120ccc;
}

.ckey.wide {
	width: 196dp;
	font-size: 22dp;
}

.ckey.ready { color: #ff9a3c; }

.ckey.sel {
	decorator: horizontal-gradient(#ff8a2c #e8251f);
	color: #1a0705;
}

.ckey.space { font-size: 15dp; }
